{
  "manifest_version": 3,
  "name": "Sanoja - Finnish Translator & Dictionary",
  "version": "2.1.14",
  "description": "Finnish translator & dictionary: select any word on the web to translate English ↔ Finnish, hear it, and review with flashcards.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["icons.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
